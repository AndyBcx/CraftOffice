+
+/// CraftOffice: the Hungarian and Romanian dictionaries built into the browser (and Android)
+/// build, which has no dictionaries folder to read (LibreOffice's, zlib-compressed). They are
+/// found last, under pseudo-paths starting with [`BUILT_IN_DIR`].
+#[cfg(target_arch = "wasm32")]
+const BUILT_IN: &[(&str, &[u8], &[u8])] = &[
+    ("hu_HU", include_bytes!("craftoffice_dicts/hu_HU.aff.z"), include_bytes!("craftoffice_dicts/hu_HU.dic.z")),
+    ("ro_RO", include_bytes!("craftoffice_dicts/ro_RO.aff.z"), include_bytes!("craftoffice_dicts/ro_RO.dic.z")),
+];
+#[cfg(not(target_arch = "wasm32"))]
+const BUILT_IN: &[(&str, &[u8], &[u8])] = &[];
+
+/// The pseudo-folder of the built-in dictionaries.
+const BUILT_IN_DIR: &str = "craftoffice-built-in";
+
+/// The built-in dictionary for any of `names` (`hu_HU`, `hu-HU` or `hu`).
+fn built_in(names: &[&str]) -> Option<(PathBuf, PathBuf)> {
+    let norm = |n: &str| n.to_ascii_lowercase().replace('-', "_");
+    BUILT_IN.iter().find_map(|(b, _, _)| {
+        let full = norm(b);
+        let lang = full.split('_').next().unwrap_or_default().to_string();
+        names.iter().any(|n| norm(n) == full || norm(n) == lang).then(|| {
+            let dir = PathBuf::from(BUILT_IN_DIR);
+            (dir.join(format!("{b}.aff")), dir.join(format!("{b}.dic")))
+        })
+    })
+}
+
+/// The `.aff` and `.dic` bytes of a built-in dictionary's pseudo-paths.
+fn built_in_bytes(aff: &Path) -> Option<Result<(Vec<u8>, Vec<u8>), String>> {
+    if !aff.starts_with(BUILT_IN_DIR) {
+        return None;
+    }
+    let stem = aff.file_stem()?.to_str()?;
+    let (_, a, d) = BUILT_IN.iter().find(|(b, _, _)| *b == stem)?;
+    let unpack = |z: &[u8]| miniz_oxide::inflate::decompress_to_vec_zlib(z).map_err(|e| format!("built-in {stem}: {e:?}"));
+    Some(unpack(a).and_then(|a| unpack(d).map(|d| (a, d))))
 }
 
