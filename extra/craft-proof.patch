+/// CraftOffice: Hungarian and Romanian hyphenation built into the browser (and Android) build,
+/// which has no packs folder: LibreOffice's patterns as plain Liang patterns (the non-standard
+/// `ssz/sz=` ones left out), zlib-compressed by the web build.
+#[cfg(target_arch = "wasm32")]
+const BUILT_IN_HYPHENATION: &[(&str, &[u8])] =
+    &[("hu", include_bytes!("craftoffice_dicts/hyph_hu.pat.z")), ("ro", include_bytes!("craftoffice_dicts/hyph_ro.pat.z"))];
+#[cfg(not(target_arch = "wasm32"))]
+const BUILT_IN_HYPHENATION: &[(&str, &[u8])] = &[];
+
+fn built_in_hyphenation(lang: ProofLang) -> Option<Arc<Patterns>> {
+    static PARSED: std::sync::OnceLock<Vec<Option<Arc<Patterns>>>> = std::sync::OnceLock::new();
+    if BUILT_IN_HYPHENATION.is_empty() {
+        return None;
+    }
+    let locales = hyphenation_locales(lang);
+    let i = BUILT_IN_HYPHENATION.iter().position(|(l, _)| locales.iter().any(|x| x == l || x.split('-').next() == Some(l)))?;
+    let all = PARSED.get_or_init(|| {
+        BUILT_IN_HYPHENATION
+            .iter()
+            .map(|(_, z)| {
+                let raw = miniz_oxide::inflate::decompress_to_vec_zlib(z).ok()?;
+                let p = Patterns::parse(std::str::from_utf8(&raw).ok()?);
+                (!p.is_empty()).then(|| Arc::new(p))
+            })
+            .collect()
+    });
+    all.get(i).cloned().flatten()
+}
