+/// CraftOffice: add the fonts that come with the app to the font database. They are files beside
+/// the page (`fonts/list.txt` names them, one per line), fetched after the window is up, so a
+/// phone or a browser without the usual document fonts (Arial, Times New Roman, Calibri…) has
+/// their metric-compatible twins and other common faces. A missing list adds nothing.
+fn craftoffice_fonts(ctx: egui::Context) {
+    async fn fetch(window: &web_sys::Window, url: &str) -> Option<Vec<u8>> {
+        let resp = wasm_bindgen_futures::JsFuture::from(window.fetch_with_str(url)).await.ok()?;
+        let resp: web_sys::Response = resp.dyn_into().ok()?;
+        if !resp.ok() {
+            return None;
+        }
+        let buf = wasm_bindgen_futures::JsFuture::from(resp.array_buffer().ok()?).await.ok()?;
+        Some(js_sys::Uint8Array::new(&buf).to_vec())
+    }
+    wasm_bindgen_futures::spawn_local(async move {
+        let Some(window) = web_sys::window() else { return };
+        let Some(list) = fetch(&window, "fonts/list.txt").await else { return };
+        let list = String::from_utf8_lossy(&list).into_owned();
+        let mut added = 0usize;
+        for name in list.lines().map(str::trim).filter(|l| !l.is_empty() && !l.starts_with('#')) {
+            let Some(bytes) = fetch(&window, &format!("fonts/{name}")).await else {
+                log::warn!("font {name} is missing");
+                continue;
+            };
+            match wordcraft_fonts::FontDb::global().install_font(name, &bytes) {
+                Ok(_) => added += 1,
+                Err(wordcraft_fonts::UserFontError::AlreadyAvailable(_)) => {}
+                Err(e) => log::warn!("font {name} skipped: {e}"),
+            }
+            if added % 8 == 0 {
+                ctx.request_repaint();
+            }
+        }
+        log::info!("CraftOffice: {added} fonts added");
+        ctx.request_repaint();
+    });
+}
