diff --git a/apps/texturecraft/src/craftoffice_i18n.rs b/apps/texturecraft/src/craftoffice_i18n.rs
index 26e8e25e..aee47a1f 100644
--- a/apps/texturecraft/src/craftoffice_i18n.rs
+++ b/apps/texturecraft/src/craftoffice_i18n.rs
@@ -49,6 +49,17 @@ pub fn install() {
             }
         }
     }
+    // the app's own Hungarian / Romanian tables (English text → translation)
+    let table: &[(&str, &str)] = match language() {
+        Some("hu") => texturecraft_ui_egui::i18n::hu::TABLE,
+        Some("ro") => texturecraft_ui_egui::i18n::ro::TABLE,
+        _ => &[],
+    };
+    for (k, v) in table {
+        if !k.is_empty() && !v.trim().is_empty() {
+            map.entry(*k).or_insert(*v);
+        }
+    }
     let _ = MAP.set(map);
     egui::widget_text::set_ui_text_translator(lookup);
 }
