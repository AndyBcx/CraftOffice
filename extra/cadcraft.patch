+/// CraftOffice: plot with the Plot dialog's settings and send the PDF to the chosen printer.
+fn print_plot(app: &mut CadApp, params: Value, target: &str) {
+    if app.ui.dialog.as_deref() == Some("plot") {
+        app.ui.dialog = None;
+    }
+    let pdf = match app.run("plot", params) {
+        Ok(r) => r.get("data").and_then(Value::as_str).and_then(cadcraft_engine::cmd::file::base64_decode),
+        Err(_) => {
+            app.ui.dialog = Some("plot".into());
+            return;
+        }
+    };
+    let Some(pdf) = pdf else {
+        app.session.echo("The plot made no PDF to print.".to_string());
+        return;
+    };
+    let title = app.session.state().map(|s| s.title.clone()).unwrap_or_default();
+    let title = if title.is_empty() { format!("CraftOffice CAD - {target}") } else { format!("{title} - {target}") };
+    match crate::direct_print::send(&app.services, pdf, &title) {
+        Ok(printer) => app.session.echo(format!("{} {printer}…", crate::i18n::t("Sending to the printer"))),
+        Err(e) => {
+            app.session.echo(e);
+            app.ui.dialog = Some("plot".into());
+        }
+    }
+}
