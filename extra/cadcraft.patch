diff --git a/crates/ui-egui/src/direct_print.rs b/crates/ui-egui/src/direct_print.rs
new file mode 100644
index 0000000..d8edc31
--- /dev/null
+++ b/crates/ui-egui/src/direct_print.rs
@@ -0,0 +1,219 @@
+//! CraftOffice: the Plot dialog's "Printer" choice. Next to the PDF file route, the plot can go
+//! straight to a system printer: PLOT makes the same PDF (without a path it returns the bytes)
+//! and the host's spooler service sends it on a worker thread, at the plotted scale.
+//!
+//! The choice lives on the UI thread only, so it stays out of the page setups saved in the drawing.
+
+use std::cell::RefCell;
+use std::sync::mpsc::{Receiver, TryRecvError};
+use std::sync::Arc;
+use std::time::Duration;
+
+/// A printer the system spooler offers.
+#[derive(Clone, Debug, PartialEq)]
+pub struct PrinterInfo {
+    pub name: String,
+    pub label: String,
+    pub default: bool,
+}
+
+/// One print job. `duplex`: 0 one-sided, 1 long edge, 2 short edge.
+#[derive(Clone, Debug, PartialEq)]
+pub struct PrintJob {
+    pub printer: String,
+    pub copies: u32,
+    pub duplex: u8,
+    pub grayscale: bool,
+    pub title: String,
+}
+
+/// Lists the system printers (slow: called off the UI thread).
+pub type PrintersFn = Arc<dyn Fn() -> Vec<PrinterInfo> + Send + Sync>;
+
+/// Hands a PDF to the spooler (slow: called on a worker thread).
+pub type PrintPdfFn = Arc<dyn Fn(&[u8], &PrintJob) -> Result<(), String> + Send + Sync>;
+
+const SIDES: [(u8, &str); 3] = [
+    (0, "Print One Sided"),
+    (1, "Print on Both Sides (flip on long edge)"),
+    (2, "Print on Both Sides (flip on short edge)"),
+];
+
+struct State {
+    printers: Vec<PrinterInfo>,
+    loading: Option<Receiver<Vec<PrinterInfo>>>,
+    asked: bool,
+    /// `None`: plot to a file (the original route).
+    printer: Option<String>,
+    copies: u32,
+    sides: u8,
+    grayscale: bool,
+    /// Jobs on their way to the spooler: (printer, answer).
+    sending: Vec<(String, Receiver<Result<(), String>>)>,
+}
+
+impl Default for State {
+    fn default() -> Self {
+        State { printers: Vec::new(), loading: None, asked: false, printer: None, copies: 1, sides: 0, grayscale: false, sending: Vec::new() }
+    }
+}
+
+thread_local! {
+    static STATE: RefCell<State> = RefCell::new(State::default());
+}
+
+/// A label through the interface catalog.
+fn tr(s: &str) -> String {
+    crate::i18n::t(s).to_string()
+}
+
+fn discover(list: &Option<PrintersFn>, s: &mut State) {
+    s.asked = true;
+    let Some(list) = list.clone() else { return };
+    let (tx, rx) = std::sync::mpsc::channel();
+    if std::thread::Builder::new().name("print-discovery".into()).spawn(move || drop(tx.send(list()))).is_ok() {
+        s.loading = Some(rx);
+    }
+}
+
+/// The "Printer" row at the top of the Plot dialog (only where the host can print).
+pub fn section(services: &crate::Services, ui: &mut egui::Ui) {
+    if services.print_pdf.is_none() {
+        return;
+    }
+    STATE.with_borrow_mut(|s| {
+        if !s.asked {
+            discover(&services.printers, s);
+        }
+        if let Some(rx) = &s.loading {
+            match rx.try_recv() {
+                Ok(list) => {
+                    s.printers = list;
+                    s.loading = None;
+                }
+                Err(TryRecvError::Empty) => ui.ctx().request_repaint_after(Duration::from_millis(200)),
+                Err(TryRecvError::Disconnected) => s.loading = None,
+            }
+        }
+        let label = |p: &PrinterInfo| if p.label.is_empty() { p.name.clone() } else { p.label.clone() };
+        let file = tr("File (PDF, PNG, SVG)");
+        let selected = match &s.printer {
+            None => file.clone(),
+            Some(name) => s.printers.iter().find(|p| &p.name == name).map_or_else(|| name.clone(), label),
+        };
+        egui::Grid::new("craftoffice_print_grid").num_columns(2).spacing(egui::vec2(10.0, 6.0)).show(ui, |ui| {
+            ui.label("Printer");
+            ui.horizontal(|ui| {
+                craft_ui::ComboBox::from_id_salt("craftoffice_print_to").selected_text(selected).width(190.0).show_ui(ui, |ui| {
+                    if ui.selectable_label(s.printer.is_none(), file.as_str()).clicked() {
+                        s.printer = None;
+                    }
+                    if s.loading.is_some() && s.printers.is_empty() {
+                        ui.label("Looking for printers…");
+                    }
+                    for p in &s.printers {
+                        let text = if p.default { format!("{} ({})", label(p), tr("default")) } else { label(p) };
+                        if ui.selectable_label(s.printer.as_ref() == Some(&p.name), text).clicked() {
+                            s.printer = Some(p.name.clone());
+                        }
+                    }
+                });
+                if ui.small_button("⟳").on_hover_text("Refresh the printer list").clicked() {
+                    discover(&services.printers, s);
+                }
+            });
+            ui.end_row();
+            if s.printer.is_some() {
+                ui.label("Copies");
+                ui.add(egui::DragValue::new(&mut s.copies).range(1..=999).speed(0.2));
+                ui.end_row();
+                ui.label("Sides");
+                let sides = SIDES.iter().find(|x| x.0 == s.sides).map_or(SIDES[0].1, |x| x.1);
+                craft_ui::ComboBox::from_id_salt("craftoffice_print_sides").selected_text(tr(sides)).width(250.0).show_ui(ui, |ui| {
+                    for (id, text) in SIDES {
+                        if ui.selectable_label(s.sides == id, text).clicked() {
+                            s.sides = id;
+                        }
+                    }
+                });
+                ui.end_row();
+                ui.label("");
+                ui.checkbox(&mut s.grayscale, "Print in grayscale");
+                ui.end_row();
+            }
+        });
+    });
+}
+
+/// A printer is chosen: OK prints instead of asking for a file.
+pub fn to_printer() -> bool {
+    STATE.with_borrow(|s| s.printer.is_some())
+}
+
+/// The job for the chosen printer, titled `title`.
+pub fn job(title: &str) -> Option<PrintJob> {
+    STATE.with_borrow(|s| {
+        s.printer.clone().map(|printer| PrintJob { printer, copies: s.copies.clamp(1, 999), duplex: s.sides, grayscale: s.grayscale, title: title.to_string() })
+    })
+}
+
+/// Send `pdf` to the chosen printer on a worker thread; [`poll`] reports the answer.
+pub fn send(services: &crate::Services, pdf: Vec<u8>, title: &str) -> Result<String, String> {
+    let job = job(title).ok_or_else(|| tr("Choose a printer first."))?;
+    let submit = services.print_pdf.clone().ok_or_else(|| tr("Printing to a printer isn't available here."))?;
+    let printer = job.printer.clone();
+    let (tx, rx) = std::sync::mpsc::channel();
+    std::thread::Builder::new()
+        .name("print-submit".into())
+        .spawn(move || drop(tx.send(submit(&pdf, &job))))
+        .map_err(|e| e.to_string())?;
+    STATE.with_borrow_mut(|s| s.sending.push((printer.clone(), rx)));
+    Ok(printer)
+}
+
+/// Every frame: echo the answers of the jobs sent to the spooler.
+pub fn poll(app: &mut crate::CadApp, ctx: &egui::Context) {
+    let done: Vec<(String, Result<(), String>)> = STATE.with_borrow_mut(|s| {
+        let mut done = Vec::new();
+        s.sending.retain(|(printer, rx)| match rx.try_recv() {
+            Ok(r) => {
+                done.push((printer.clone(), r));
+                false
+            }
+            Err(TryRecvError::Empty) => true,
+            Err(TryRecvError::Disconnected) => {
+                done.push((printer.clone(), Err("the print job stopped".into())));
+                false
+            }
+        });
+        if !s.sending.is_empty() {
+            ctx.request_repaint_after(Duration::from_millis(250));
+        }
+        done
+    });
+    for (printer, r) in done {
+        app.session.echo(match r {
+            Ok(()) => format!("{} {printer}", tr("Sent to the printer")),
+            Err(e) => format!("{} {printer}: {e}", tr("Printing failed:")),
+        });
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_file_route_is_the_default_and_a_printer_makes_a_job() {
+        assert!(!to_printer());
+        assert!(job("x").is_none());
+        STATE.with_borrow_mut(|s| {
+            s.printer = Some("P".into());
+            s.copies = 0;
+            s.sides = 2;
+        });
+        let j = job("Plot").unwrap();
+        assert_eq!((j.printer.as_str(), j.copies, j.duplex, j.title.as_str()), ("P", 1, 2, "Plot"));
+        STATE.with_borrow_mut(|s| *s = State::default());
+    }
+}
