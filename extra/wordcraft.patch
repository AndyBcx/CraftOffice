diff --git a/crates/engine/src/langdata.rs b/crates/engine/src/langdata.rs
index c04b0f5..83835b3 100644
--- a/crates/engine/src/langdata.rs
+++ b/crates/engine/src/langdata.rs
@@ -352,3 +352,54 @@ mod tests {
         assert_eq!(l.replacement("x"), None);
     }
 }
+
+/// CraftOffice: the language data installed beside the built-in English (Hungarian, Romanian and
+/// any other Hunspell dictionary, hyphenation pattern, autocorrect list and thesaurus in the
+/// dictionaries folders), each as (title, licence or readme text), for Help › About › Language data.
+pub fn installed_language_data() -> Vec<(String, String)> {
+    let mut out: Vec<(String, String)> = Vec::new();
+    let mut seen = std::collections::BTreeSet::new();
+    for d in dirs() {
+        let Ok(rd) = std::fs::read_dir(&d) else { continue };
+        let mut files: Vec<PathBuf> = rd.flatten().filter(|e| e.file_type().is_ok_and(|t| t.is_file())).map(|e| e.path()).collect();
+        files.sort();
+        let readme = |stem: &str| -> String {
+            let want = [format!("readme_{}.txt", stem.to_lowercase()), format!("readme_{}.txt", stem.to_lowercase().trim_start_matches("hyph_"))];
+            files
+                .iter()
+                .find(|f| f.file_name().and_then(|n| n.to_str()).is_some_and(|n| want.contains(&n.to_lowercase())))
+                .and_then(|f| read_capped(f))
+                .map(|b| String::from_utf8_lossy(&b).into_owned())
+                .unwrap_or_default()
+        };
+        for f in &files {
+            let Some(name) = f.file_name().and_then(|n| n.to_str()) else { continue };
+            let lower = name.to_lowercase();
+            let Some(stem) = name.rsplit_once('.').map(|(s, _)| s) else { continue };
+            let title = if lower.starts_with("hyph_") && lower.ends_with(".dic") {
+                format!("{}: hyphenation ({name})", stem.trim_start_matches("hyph_"))
+            } else if lower.ends_with(".dic") {
+                format!("{stem}: spelling dictionary ({name})")
+            } else if lower.starts_with("acor_") && lower.ends_with(".dat") {
+                format!("{}: autocorrect list ({name})", stem.trim_start_matches("acor_"))
+            } else if lower.starts_with("th_") && lower.ends_with(".dat") {
+                format!("{}: thesaurus ({name})", stem.trim_start_matches("th_").trim_end_matches("_v2"))
+            } else {
+                continue;
+            };
+            if !seen.insert(lower.clone()) {
+                continue;
+            }
+            let lang = stem.trim_start_matches("hyph_").trim_start_matches("acor_").trim_start_matches("th_").trim_end_matches("_v2");
+            let mut text = readme(stem);
+            if text.is_empty() {
+                text = readme(&lang.replace('-', "_"));
+            }
+            if text.is_empty() {
+                text = format!("{}\n(LibreOffice language data; see the licence that came with it.)", f.display());
+            }
+            out.push((title, text));
+        }
+    }
+    out
+}
