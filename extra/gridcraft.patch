+    assert!(s.doc().unwrap().is_dirty());
+    s.execute("file.save", json!({})).unwrap();
+    assert_eq!(gridcraft_xlsx::sniff(&std::fs::read(&path).unwrap()), gridcraft_xlsx::Format::Xlsx);
