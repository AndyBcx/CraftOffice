+/// CraftOffice: File › Info › Protect Workbook › Encrypt with Password. Sets (or with `null` or
+/// an empty string removes) the password the next `.xlsx` saves are encrypted with.
+fn encrypt(s: &mut Session, p: &Json) -> Result<Json> {
+    let password = match p.get("password") {
+        None => {
+            s.ui_requests.push(crate::UiRequest::Dialog("encryptPassword".into(), json!({})));
+            return ok();
+        }
+        Some(Json::Null) => None,
+        Some(Json::String(pw)) if pw.is_empty() => None,
+        Some(Json::String(pw)) => Some(pw.clone()),
+        Some(_) => return Err(bad("file.encrypt", "`password` must be a string, or null to remove the password")),
+    };
+    if let (Some(pw), Some(confirm)) = (&password, str_param(p, "confirmPassword"))
+        && pw != confirm
+    {
+        return Err(bad("file.encrypt", "The passwords don't match. Type the same password in both boxes."));
+    }
+    if let Some(pw) = &password
+        && pw.chars().count() > 255
+    {
+        return Err(bad("file.encrypt", "The password can have at most 255 characters."));
+    }
+    let d = s.doc_mut()?;
+    if d.password != password {
+        d.password = password;
+        d.password_changed = true;
+    }
+    Ok(json!({"encrypted": d.password.is_some()}))
+}
