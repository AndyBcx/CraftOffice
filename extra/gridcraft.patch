+/// CraftOffice: `package` (an `.xlsx` zip) as Excel stores it with a password: Agile encryption
+/// (AES-256, SHA-512, 100,000 spins) in a compound file with the data-spaces streams.
+pub fn encrypt(package: &[u8], password: &str) -> Result<Vec<u8>, String> {
+    if password.is_empty() {
+        return Err("The password is empty.".into());
+    }
+    if password.chars().count() > 255 {
+        return Err("The password can have at most 255 characters.".into());
+    }
+    craft_offcrypto::encrypt(package, password).map_err(|e| e.to_string())
+}
