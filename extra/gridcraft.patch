+    assert_eq!(r["encrypted"], true);
+    s.execute("file.save", json!({"path": path})).unwrap();
+    assert!(!s.doc().unwrap().is_dirty());
+    let saved = std::fs::read(&path).unwrap();
+    assert_eq!(gridcraft_xlsx::sniff(&saved), gridcraft_xlsx::Format::Encrypted);
