+    const PW: &str = "synthetic-pw-7781";
+    let nonce = unique_nonce();
+    let dir = std::env::temp_dir().join(format!("gridcraft-encrypt-{}-{nonce}", std::process::id()));
+    std::fs::create_dir(&dir).unwrap();
+    let path = dir.join("Book.xlsx");
+    let mut s = s();
+    s.execute("cell.set", json!({"cell": "A1", "input": "7"})).unwrap();
+    // No password param: the dialog asks for it.
+    s.execute("file.encrypt", json!({})).unwrap();
+    assert!(s.take_ui_requests().iter().any(|r| matches!(r, crate::UiRequest::Dialog(name, _) if name == "encryptPassword")));
