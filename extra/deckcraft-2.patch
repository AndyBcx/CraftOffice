+#[cfg(all(test, not(target_arch = "wasm32")))]
+mod craftoffice_encrypt_tests {
+    use serde_json::json;
+
+    use crate::Session;
+
+    #[test]
+    fn a_presentation_saves_encrypted_and_reopens_with_its_password() {
+        const PW: &str = "synthetic-pw-3141";
+        let dir = std::env::temp_dir().join(format!("deckcraft-encrypt-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let path = dir.join("Secret.pptx");
+        let path_s = path.to_str().unwrap();
+        let mut s = Session::new();
+        s.execute("file.new", &json!({})).unwrap();
+        assert!(s.execute("file.encrypt", &json!({"password": PW, "confirmPassword": "other"})).is_err());
+        assert_eq!(s.execute("file.encrypt", &json!({"password": PW, "confirmPassword": PW})).unwrap()["encrypted"], true);
+        assert!(s.doc().unwrap().is_dirty());
+        s.execute("file.save", &json!({"path": path_s})).unwrap();
+        assert!(!s.doc().unwrap().is_dirty());
+        let bytes = std::fs::read(&path).unwrap();
+        assert!(deckcraft_pptx::is_encrypted(&bytes), "saved encrypted");
+        let journal = serde_json::to_string(&s.journal).unwrap();
+        assert!(!journal.contains(PW), "the password never reaches the journal");
+
+        let mut t = Session::new();
+        let e = t.execute("file.open", &json!({"path": path_s})).unwrap_err().to_string();
+        assert!(e.contains(super::PASSWORD_REQUIRED), "{e}");
+        let e = t.execute("file.open", &json!({"path": path_s, "password": "wrong"})).unwrap_err().to_string();
+        assert!(e.contains(super::WRONG_PASSWORD), "{e}");
+        t.execute("file.open", &json!({"path": path_s, "password": PW})).unwrap();
+        assert_eq!(t.doc().unwrap().password.as_deref(), Some(PW));
+        assert_eq!(t.doc().unwrap().path.as_deref(), Some(path_s));
+        // Removing the password: the next save is a plain .pptx again.
+        t.execute("file.encrypt", &json!({"password": null})).unwrap();
+        t.execute("file.save", &json!({})).unwrap();
+        assert!(!deckcraft_pptx::is_encrypted(&std::fs::read(&path).unwrap()));
+        std::fs::remove_dir_all(dir).unwrap();
+    }
+}
