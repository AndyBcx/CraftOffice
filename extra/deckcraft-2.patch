+/// CraftOffice: the open error of a password-protected presentation contains this.
+pub const PASSWORD_REQUIRED: &str = "is password-protected. Enter its password to open it.";
+/// CraftOffice: the open error for a wrong password.
+pub const WRONG_PASSWORD: &str = "The password is incorrect.";
+
+/// CraftOffice: File › Info › Protect Presentation › Encrypt with Password: set (or with `null`
+/// or "" remove) the password the next `.pptx` saves are encrypted with.
+fn encrypt(s: &mut Session, p: &Value) -> Result<Value> {
+    let password = match p.get("password") {
+        None | Some(Value::Null) => None,
+        Some(Value::String(pw)) if pw.is_empty() => None,
+        Some(Value::String(pw)) => Some(pw.clone()),
+        Some(_) => return Err(bad("file.encrypt", "`password` must be a string, or null to remove the password")),
+    };
+    if let (Some(pw), Some(confirm)) = (&password, str_param(p, "confirmPassword"))
+        && pw != confirm
+    {
+        return Err(bad("file.encrypt", "The passwords don't match. Type the same password in both boxes."));
+    }
+    if password.as_ref().is_some_and(|pw| pw.chars().count() > 255) {
+        return Err(bad("file.encrypt", "The password can have at most 255 characters."));
+    }
+    let st = s.doc_mut()?;
+    if st.password != password {
+        st.password = password;
+        st.password_changed = true;
+    }
+    Ok(json!({"encrypted": st.password.is_some()}))
+}
