@@ -0,0 +1,125 @@
+//! CraftOffice: the password prompts of Slides. Opening a password-protected `.pptx` asks for
+//! its password; File › Info › Encrypt with Password sets the one Save encrypts with.
+
+use std::cell::RefCell;
+
+use serde_json::json;
+
+use crate::SlideApp;
+
+enum Kind {
+    /// Open the file at this path with the password.
+    Open(String),
+    /// Set the active presentation's password.
+    Encrypt,
+}
+
+struct Prompt {
+    kind: Kind,
+    password: String,
+    confirm: String,
+    error: Option<String>,
+}
+
+thread_local! {
+    static PROMPT: RefCell<Option<Prompt>> = const { RefCell::new(None) };
+}
+
+/// A UI string through the egui text hook (the CraftOffice translation catalogs).
+fn crate_tr(s: &'static str) -> String {
+    egui::WidgetText::from(s).text().to_string()
+}
+
+/// Ask for the password of the presentation at `path`.
+pub fn ask_open(path: &str) {
+    PROMPT.with_borrow_mut(|p| *p = Some(Prompt { kind: Kind::Open(path.to_string()), password: String::new(), confirm: String::new(), error: None }));
+}
+
+/// Ask for the password to encrypt the active presentation with.
+pub fn ask_encrypt() {
+    PROMPT.with_borrow_mut(|p| *p = Some(Prompt { kind: Kind::Encrypt, password: String::new(), confirm: String::new(), error: None }));
+}
+
+/// The error of an open that needs a password.
+pub fn needs_password(error: &str) -> bool {
+    error.contains(deckcraft_engine::cmd::file::PASSWORD_REQUIRED)
+}
+
+/// Draw the prompt, if one is open. Call once a frame.
+pub fn show(app: &mut SlideApp, ctx: &egui::Context) {
+    let Some(mut prompt) = PROMPT.with_borrow_mut(Option::take) else { return };
+    let mut close = false;
+    let mut submit = false;
+    let (title, text) = match &prompt.kind {
+        Kind::Open(path) => {
+            let name = std::path::Path::new(path).file_name().and_then(|n| n.to_str()).unwrap_or(path).to_string();
+            ("Password", format!("{name}\n{}", crate_tr("This presentation is protected. Enter the password to open it.")))
+        }
+        Kind::Encrypt => ("Encrypt Presentation", crate_tr("Encrypt the contents of this file. If you lose or forget the password, it cannot be recovered.").to_string()),
+    };
+    egui::Modal::new(egui::Id::new("craftoffice-password")).show(ctx, |ui| {
+        ui.set_width(360.0);
+        ui.heading(title);
+        ui.add_space(4.0);
+        ui.label(text);
+        ui.add_space(8.0);
+        let l = ui.label("Password:");
+        let r = ui.add(egui::TextEdit::singleline(&mut prompt.password).password(true).desired_width(f32::INFINITY)).labelled_by(l.id);
+        if r.lost_focus() && ui.input(|i| i.key_pressed(egui::Key::Enter)) && matches!(prompt.kind, Kind::Open(_)) {
+            submit = true;
+        }
+        if matches!(prompt.kind, Kind::Encrypt) {
+            let l = ui.label("Reenter password:");
+            let r = ui.add(egui::TextEdit::singleline(&mut prompt.confirm).password(true).desired_width(f32::INFINITY)).labelled_by(l.id);
+            if r.lost_focus() && ui.input(|i| i.key_pressed(egui::Key::Enter)) {
+                submit = true;
+            }
+        }
+        if let Some(e) = &prompt.error {
+            ui.add_space(4.0);
+            ui.colored_label(ui.visuals().error_fg_color, e.as_str());
+        }
+        ui.add_space(8.0);
+        ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| {
+            if ui.button("Cancel").clicked() {
+                close = true;
+            }
+            if ui.add_enabled(!prompt.password.is_empty(), egui::Button::new("OK")).clicked() {
+                submit = true;
+            }
+        });
+    });
+    if ctx.input_mut(|i| i.consume_key(egui::Modifiers::NONE, egui::Key::Escape)) {
+        close = true;
+    }
+    if submit && !prompt.password.is_empty() {
+        let result = match &prompt.kind {
+            Kind::Open(path) => app.session.execute("file.open", &json!({"path": path, "password": prompt.password})).map(|_| app.note_recent(path)),
+            Kind::Encrypt => app
+                .session
+                .execute("file.encrypt", &json!({"password": prompt.password, "confirmPassword": prompt.confirm}))
+                .map(|_| app.set_status("The presentation will be saved with a password.")),
+        };
+        match result {
+            Ok(()) => close = true,
+            Err(e) => {
+                prompt.error = Some(e.to_string());
+                prompt.password.clear();
+                prompt.confirm.clear();
+            }
+        }
+    }
+    if !close {
+        PROMPT.with_borrow_mut(|p| *p = Some(prompt));
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    #[test]
+    fn the_open_error_of_a_protected_file_asks_for_the_password() {
+        let e = format!("Deck.pptx {}", deckcraft_engine::cmd::file::PASSWORD_REQUIRED);
+        assert!(super::needs_password(&e));
+        assert!(!super::needs_password("Deck.pptx: not a presentation DeckCraft can read"));
+    }
+}
