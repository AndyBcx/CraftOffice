+/// A CraftOffice csomag verziója: a repó VERSION fájlja (a build is ezt írja az appok névjegyébe).
+pub const SUITE_VERSION: &str = include_str!("../../VERSION");
+
+pub fn suite_version() -> &'static str {
+    SUITE_VERSION.trim()
+}
+
+/// Hol készül az új CraftOffice (GitHub Actions: a „craftoffice-windows-x64” csomag).
+pub const SUITE_PAGE: &str = "https://github.com/AndyBcx/CraftOffice/actions";
+
+/// A CraftOffice legújabb verziója a GitHubon (háttérszálon) → `Msg::Latest("craftoffice", …)`.
+pub fn spawn_check_suite(tx: Sender<Msg>, ctx: egui::Context) {
+    std::thread::spawn(move || {
+        let url = "https://raw.githubusercontent.com/AndyBcx/CraftOffice/main/VERSION";
+        match http_get(url, None, false) {
+            Ok(b) => {
+                let v = String::from_utf8_lossy(&b).trim().to_string();
+                if !v.is_empty() && v.len() < 32 && v.chars().all(|c| c.is_ascii_alphanumeric() || ".-+".contains(c)) {
+                    log(&format!("CraftOffice: legújabb {v}, ez {}", suite_version()));
+                    let _ = tx.send(Msg::Latest("craftoffice", v));
+                    ctx.request_repaint();
+                }
+            }
+            Err(e) => log(&format!("CraftOffice verzió: {e}")),
+        }
+    });
+}
+
