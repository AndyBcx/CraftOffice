diff --git a/crates/ui-egui/src/dialogs/direct_print.rs b/crates/ui-egui/src/dialogs/direct_print.rs
new file mode 100644
index 0000000..d3706ee
--- /dev/null
+++ b/crates/ui-egui/src/dialogs/direct_print.rs
@@ -0,0 +1,159 @@
+//! CraftOffice: File › Print… straight to a system printer (Lightroom's Print Job › Print to:
+//! Printer), next to the existing PDF file route. The pages are the same PDF the export task
+//! already writes; the host's spooler service sends them to the printer on the print thread.
+//!
+//! The choice lives on the UI thread only, so it stays out of the print settings (which are
+//! saved in templates) and survives closing and reopening the dialog.
+
+use std::cell::RefCell;
+use std::sync::mpsc::{Receiver, TryRecvError};
+use std::time::Duration;
+
+use egui::Ui;
+
+use crate::LightcraftApp;
+use crate::services::{PrintJob, PrinterInfo};
+
+const SIDES: [(u8, &str); 3] = [
+    (0, "Print One Sided"),
+    (1, "Print on Both Sides (flip on long edge)"),
+    (2, "Print on Both Sides (flip on short edge)"),
+];
+
+struct State {
+    printers: Vec<PrinterInfo>,
+    loading: Option<Receiver<Vec<PrinterInfo>>>,
+    asked: bool,
+    /// `None`: print to a PDF file (the original route).
+    printer: Option<String>,
+    copies: u32,
+    sides: u8,
+    grayscale: bool,
+}
+
+impl Default for State {
+    fn default() -> Self {
+        State { printers: Vec::new(), loading: None, asked: false, printer: None, copies: 1, sides: 0, grayscale: false }
+    }
+}
+
+thread_local! {
+    static STATE: RefCell<State> = RefCell::new(State::default());
+}
+
+fn discover(app: &LightcraftApp, s: &mut State) {
+    s.asked = true;
+    let Some(list) = app.services.printers.clone() else { return };
+    let (tx, rx) = std::sync::mpsc::channel();
+    let spawned = std::thread::Builder::new().name("print-discovery".into()).spawn(move || {
+        let _ = tx.send(list());
+    });
+    if spawned.is_ok() {
+        s.loading = Some(rx);
+    }
+}
+
+/// The "Print to" section at the top of the Print dialog's settings.
+pub fn section(app: &LightcraftApp, ui: &mut Ui) {
+    if app.services.print_pdf.is_none() {
+        return;
+    }
+    STATE.with_borrow_mut(|s| {
+        if !s.asked {
+            discover(app, s);
+        }
+        if let Some(rx) = &s.loading {
+            match rx.try_recv() {
+                Ok(list) => {
+                    s.printers = list;
+                    s.loading = None;
+                }
+                Err(TryRecvError::Empty) => ui.ctx().request_repaint_after(Duration::from_millis(200)),
+                Err(TryRecvError::Disconnected) => s.loading = None,
+            }
+        }
+        let label = |p: &PrinterInfo| if p.label.is_empty() { p.name.clone() } else { p.label.clone() };
+        let pdf = crate::i18n::tr("PDF file").to_string();
+        let selected = match &s.printer {
+            None => pdf.clone(),
+            Some(name) => s.printers.iter().find(|p| &p.name == name).map_or_else(|| name.clone(), label),
+        };
+        ui.horizontal(|ui| {
+            ui.label(crate::i18n::tr("Print to:"));
+            egui::ComboBox::from_id_salt("craftoffice_print_to").width(190.0).selected_text(selected).show_ui(ui, |ui| {
+                if ui.selectable_label(s.printer.is_none(), pdf.as_str()).clicked() {
+                    s.printer = None;
+                }
+                if s.loading.is_some() && s.printers.is_empty() {
+                    ui.label(crate::i18n::tr("Looking for printers…"));
+                }
+                for p in &s.printers {
+                    let text = if p.default { format!("{} ({})", label(p), crate::i18n::tr("default")) } else { label(p) };
+                    if ui.selectable_label(s.printer.as_ref() == Some(&p.name), text).clicked() {
+                        s.printer = Some(p.name.clone());
+                    }
+                }
+            });
+            if ui.small_button("⟳").on_hover_text(crate::i18n::tr("Refresh the printer list")).clicked() {
+                discover(app, s);
+            }
+        });
+        if s.printer.is_some() {
+            ui.horizontal(|ui| {
+                ui.label(crate::i18n::tr("Copies:"));
+                ui.add(egui::DragValue::new(&mut s.copies).range(1..=999).speed(0.2));
+            });
+            let sides = SIDES.iter().find(|x| x.0 == s.sides).map_or(SIDES[0].1, |x| x.1);
+            egui::ComboBox::from_id_salt("craftoffice_print_sides").width(250.0).selected_text(crate::i18n::tr(sides)).show_ui(ui, |ui| {
+                for (id, text) in SIDES {
+                    if ui.selectable_label(s.sides == id, crate::i18n::tr(text)).clicked() {
+                        s.sides = id;
+                    }
+                }
+            });
+            ui.checkbox(&mut s.grayscale, crate::i18n::tr("Print in grayscale"));
+        }
+    });
+}
+
+/// A printer is chosen: the dialog's button prints instead of saving a PDF.
+pub fn to_printer() -> bool {
+    STATE.with_borrow(|s| s.printer.is_some())
+}
+
+/// The job for the chosen printer, titled `title`.
+pub fn job(title: &str) -> Option<PrintJob> {
+    STATE.with_borrow(|s| {
+        s.printer.clone().map(|printer| PrintJob { printer, copies: s.copies.clamp(1, 999), duplex: s.sides, grayscale: s.grayscale, title: title.to_string() })
+    })
+}
+
+/// Where the pages go on their way to the printer: a file in the temporary folder.
+pub fn spool_path() -> String {
+    let n = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map_or(0, |d| d.as_millis());
+    std::env::temp_dir().join(format!("craftoffice-print-{}-{n}.pdf", std::process::id())).to_string_lossy().into_owned()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_pdf_route_is_the_default() {
+        assert!(!to_printer());
+        assert!(job("x").is_none());
+        assert!(spool_path().ends_with(".pdf"));
+    }
+
+    #[test]
+    fn a_chosen_printer_makes_a_job() {
+        STATE.with_borrow_mut(|s| {
+            s.printer = Some("P".into());
+            s.copies = 0;
+            s.sides = 2;
+        });
+        let j = job("Print").unwrap();
+        assert_eq!((j.printer.as_str(), j.copies, j.duplex, j.title.as_str()), ("P", 1, 2, "Print"));
+        STATE.with_borrow_mut(|s| *s = State::default());
+    }
+}
