@@ -48,9 +48,37 @@ pub type HostAction = Box<dyn FnMut(&mut Session) -> Result<Value, String>>;
 /// last heard and wakes the UI itself when that changes; it is never polled for changes.
 pub type SystemThemeFn = Box<dyn Fn(&egui::Context) -> Option<egui::Theme>>;
 
+/// CraftOffice: a printer the system spooler offers for direct printing.
+#[derive(Clone, Debug, PartialEq)]
+pub struct PrinterInfo {
+    pub name: String,
+    pub label: String,
+    pub default: bool,
+}
+
+/// CraftOffice: one direct print job. `duplex`: 0 one-sided, 1 long edge, 2 short edge.
+#[derive(Clone, Debug, PartialEq)]
+pub struct PrintJob {
+    pub printer: String,
+    pub copies: u32,
+    pub duplex: u8,
+    pub grayscale: bool,
+    pub title: String,
+}
+
+/// Lists the system printers (slow: call it off the UI thread).
+pub type PrintersFn = std::sync::Arc<dyn Fn() -> Vec<PrinterInfo> + Send + Sync>;
+
+/// Hands a PDF to the spooler (slow: called on the print worker thread).
+pub type PrintPdfFn = std::sync::Arc<dyn Fn(&[u8], &PrintJob) -> Result<(), String> + Send + Sync>;
+
 /// Platform services injected by the host app (desktop or web).
 #[derive(Default)]
 pub struct Services {
+    /// CraftOffice: printer discovery for File › Print; absent on the web.
+    pub printers: Option<PrintersFn>,
