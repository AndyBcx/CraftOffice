+// ---------- Hyphenation packs from the dictionaries folder (CraftOffice) ----------
+
+/// The dictionaries folder (CraftOffice's `szotarak`) holds LibreOffice's hyphenation patterns
+/// (`hyph_hu_HU.dic`, `hyph_ro_RO.dic`), which proofing reads only from Language packs. So when
+/// the packs folder is set, a pack is made from each one whose language has no pack yet: its
+/// patterns as plain Liang patterns (the non-standard `ssz/sz=sz,1,3` ones, which those cannot
+/// express, left out) and a `pack.toml`. A pack installed from the store later replaces it.
+#[cfg(not(target_arch = "wasm32"))]
+pub fn seed_hyphenation_packs(packs: &Path) {
+    const LANGS: &[(&str, &str, &str)] = &[("hu", "hyph_hu_hu", "Magyar"), ("ro", "hyph_ro_ro", "Română")];
+    let mut made = false;
+    for (locale, prefix, name) in LANGS {
+        let dir = packs.join(locale);
+        if dir.join("pack.toml").exists() {
+            continue;
+        }
+        let Some(src) = find_hyph(prefix) else { continue };
+        let Some(data) = read_capped(&src) else { continue };
+        let pats = liang_patterns(&String::from_utf8_lossy(&data));
+        if pats.is_empty() {
+            continue;
+        }
+        let toml = format!(
+            "locale = \"{locale}\"\nname = \"{name}\"\nlicence = \"MPL 1.1 / GPL 2.0 / LGPL 2.1 (LibreOffice dictionaries)\"\nsources = \"{}\"\n",
+            src.file_name().map(|n| n.to_string_lossy().into_owned()).unwrap_or_default()
+        );
+        let ok = std::fs::create_dir_all(&dir).is_ok()
+            && std::fs::write(dir.join("hyphenation.pat"), pats).is_ok()
+            && std::fs::write(dir.join("pack.toml"), toml).is_ok();
+        log::info!("hyphenation: {locale} pack from {} ({})", src.display(), if ok { "made" } else { "failed" });
+        made |= ok;
+    }
+    if made {
+        wordcraft_proof::packs::reload();
+    }
+}
+
+/// The first `<prefix>*.dic` file in the dictionaries folders.
+#[cfg(not(target_arch = "wasm32"))]
+fn find_hyph(prefix: &str) -> Option<PathBuf> {
+    for d in dirs() {
+        let Ok(rd) = std::fs::read_dir(&d) else { continue };
+        let mut names: Vec<(String, PathBuf)> = rd
+            .flatten()
+            .filter(|e| e.file_type().is_ok_and(|t| t.is_file()))
+            .map(|e| (e.file_name().to_string_lossy().to_lowercase(), e.path()))
+            .filter(|(n, _)| n.starts_with(prefix) && n.ends_with(".dic"))
+            .collect();
+        names.sort();
+        if let Some((_, p)) = names.into_iter().next() {
+            return Some(p);
+        }
+    }
+    None
+}
+
+/// libhyphen patterns (`hyph_*.dic`) to plain Liang patterns, one per line.
+pub fn liang_patterns(text: &str) -> String {
+    let mut out = String::new();
+    for (n, line) in text.lines().enumerate() {
+        let line = line.split('%').next().unwrap_or("").trim();
+        if n == 0 || line.is_empty() {
+            continue; // the charset line
+        }
+        for tok in line.split_whitespace() {
+            if tok.contains('/') || tok.contains('-') || tok.chars().all(|c| c.is_ascii_uppercase() || c.is_ascii_digit() || c == '_') {
+                continue;
+            }
+            out.push_str(tok);
+            out.push('\n');
+        }
+    }
+    out
+}
