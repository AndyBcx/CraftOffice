+/// A built-in list (`th` or `acor`) for `lang`, unpacked.
+fn built_in(kind: &str, lang: &str) -> Option<Vec<u8>> {
+    let key = format!("{kind}_{lang}");
+    let (_, z) = BUILT_IN.iter().find(|(k, _)| *k == key)?;
+    miniz_oxide::inflate::decompress_to_vec_zlib_with_limit(z, MAX_FILE as usize).ok()
+}
