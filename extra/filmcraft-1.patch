@@ -0,0 +1,454 @@
+//! CraftOffice: Compress Video. Videos (files or whole folders) made much smaller with no visible
+//! loss: re-encoded with a modern codec at a constant visual quality (AV1 with SVT-AV1, or H.265 /
+//! H.264 with x265 / x264), keeping the size, frame rate and sound. A result that would not be
+//! smaller than its original is not kept. The originals are left as they are.
+//!
+//! The encoding is done by FFmpeg, shipped with CraftOffice in its `tools` folder (or found in
+//! `CRAFTOFFICE_FFMPEG` / on the PATH).
+
+use std::io::{BufRead, BufReader};
+use std::path::{Path, PathBuf};
+use std::process::{Command, Stdio};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Mutex, OnceLock};
+
+const VIDEO: &[&str] = &["mp4", "mov", "m4v", "mkv", "webm", "avi", "wmv", "mts", "m2ts", "ts", "mpg", "mpeg", "3gp", "flv", "mxf"];
+
+#[derive(Clone, Copy, PartialEq)]
+enum Codec {
+    Av1,
+    Hevc,
+    H264,
+}
+
+impl Codec {
+    fn label(self) -> &'static str {
+        match self {
+            Codec::Av1 => "AV1 – smallest files (newer players)",
+            Codec::Hevc => "H.265 – very small, plays on phones and TVs",
+            Codec::H264 => "H.264 – plays everywhere",
+        }
+    }
+    fn encoder(self) -> &'static str {
+        match self {
+            Codec::Av1 => "libsvtav1",
+            Codec::Hevc => "libx265",
+            Codec::H264 => "libx264",
+        }
+    }
+    /// Constant-quality values: (no visible loss, smaller with hardly visible loss).
+    fn crf(self, high: bool) -> u32 {
+        match (self, high) {
+            (Codec::Av1, true) => 28,
+            (Codec::Av1, false) => 34,
+            (Codec::Hevc, true) => 20,
+            (Codec::Hevc, false) => 24,
+            (Codec::H264, true) => 18,
+            (Codec::H264, false) => 22,
+        }
+    }
+    fn args(self, high: bool) -> Vec<String> {
+        let crf = self.crf(high).to_string();
+        let v: Vec<&str> = match self {
+            // 10-bit keeps gradients smooth at a lower rate; tune 0 is the visual-quality tuning
+            Codec::Av1 => vec!["-c:v", "libsvtav1", "-preset", "5", "-crf", &crf, "-pix_fmt", "yuv420p10le", "-svtav1-params", "tune=0:enable-overlays=1"],
+            Codec::Hevc => vec!["-c:v", "libx265", "-preset", "slow", "-crf", &crf, "-pix_fmt", "yuv420p10le", "-tag:v", "hvc1", "-x265-params", "log-level=error"],
+            Codec::H264 => vec!["-c:v", "libx264", "-preset", "slow", "-crf", &crf, "-pix_fmt", "yuv420p"],
+        };
+        v.into_iter().map(str::to_string).collect()
+    }
+}
+
+#[derive(Clone)]
+enum Status {
+    Waiting,
+    Working(f32),
+    Done { before: u64, after: u64 },
+    Kept(String),
+    Failed(String),
+}
+
+#[derive(Clone)]
+struct Row {
+    path: PathBuf,
+    root: Option<PathBuf>,
+    status: Status,
+}
+
+struct State {
+    open: bool,
+    rows: Arc<Mutex<Vec<Row>>>,
+    codec: Codec,
+    high: bool,
+    out_dir: Option<PathBuf>,
+    running: Arc<AtomicBool>,
+    stop: Arc<AtomicBool>,
+}
+
+static STATE: Mutex<Option<State>> = Mutex::new(None);
+/// The FFmpeg found, and its encoders' names (`-encoders`).
+static FFMPEG: OnceLock<Option<(PathBuf, String)>> = OnceLock::new();
+
+fn with<R>(f: impl FnOnce(&mut State) -> R) -> R {
+    let mut g = STATE.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    let s = g.get_or_insert_with(|| State {
+        open: false,
+        rows: Arc::new(Mutex::new(Vec::new())),
+        codec: Codec::Hevc,
+        high: true,
+        out_dir: None,
+        running: Arc::new(AtomicBool::new(false)),
+        stop: Arc::new(AtomicBool::new(false)),
+    });
+    f(s)
+}
+
+/// The interface language's text (the app's catalog, which has CraftOffice's lines too).
+fn t(s: &str) -> String {
+    crate::i18n::t(s).to_string()
+}
+
+pub fn open() {
+    with(|s| s.open = true);
+}
+
+fn command(exe: &Path) -> Command {
+    #[allow(unused_mut)]
+    let mut c = Command::new(exe);
+    #[cfg(windows)]
+    {
+        use std::os::windows::process::CommandExt;
+        c.creation_flags(0x0800_0000); // no console window
+    }
+    c
+}
+
+fn ffmpeg() -> Option<&'static (PathBuf, String)> {
+    FFMPEG
+        .get_or_init(|| {
+            let name = if cfg!(windows) { "ffmpeg.exe" } else { "ffmpeg" };
+            let mut tries: Vec<PathBuf> = Vec::new();
+            if let Some(p) = std::env::var_os("CRAFTOFFICE_FFMPEG") {
+                tries.push(PathBuf::from(p));
+            }
+            if let Some(dir) = std::env::current_exe().ok().and_then(|e| e.parent().map(Path::to_path_buf)) {
+                tries.push(dir.join(name));
+                tries.push(dir.join("tools").join(name));
+                tries.push(dir.join("..").join("tools").join(name));
+                tries.push(dir.join("..").join("..").join("tools").join(name));
+            }
+            tries.push(PathBuf::from(name));
+            tries.into_iter().find_map(|p| {
+                let out = command(&p).args(["-hide_banner", "-encoders"]).stdin(Stdio::null()).output().ok()?;
+                out.status.success().then(|| (p, String::from_utf8_lossy(&out.stdout).into_owned()))
+            })
+        })
+        .as_ref()
+}
+
+fn available(c: Codec) -> bool {
+    ffmpeg().is_some_and(|(_, enc)| enc.contains(c.encoder()))
+}
+
+fn is_video(p: &Path) -> bool {
+    p.extension().and_then(|e| e.to_str()).is_some_and(|e| VIDEO.contains(&e.to_ascii_lowercase().as_str()))
+}
+
+fn scan(dir: &Path, out: &mut Vec<PathBuf>, depth: usize) {
+    let Ok(rd) = std::fs::read_dir(dir) else { return };
+    let mut entries: Vec<PathBuf> = rd.filter_map(|e| e.ok().map(|e| e.path())).collect();
+    entries.sort();
+    for p in entries {
+        if p.file_name().and_then(|n| n.to_str()).is_some_and(|n| n.starts_with('.')) {
+            continue;
+        }
+        if p.is_dir() {
+            if depth < 8 {
+                scan(&p, out, depth + 1);
+            }
+        } else if is_video(&p) {
+            out.push(p);
+        }
+    }
+}
+
+pub fn add(paths: Vec<PathBuf>) {
+    let rows = with(|s| s.rows.clone());
+    let mut rows = rows.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    for p in paths {
+        let mut push = |path: PathBuf, root: Option<PathBuf>| {
+            if !rows.iter().any(|r| r.path == path) {
+                rows.push(Row { path, root, status: Status::Waiting });
+            }
+        };
+        if p.is_dir() {
+            let mut files = Vec::new();
+            scan(&p, &mut files, 0);
+            for f in files {
+                push(f, Some(p.clone()));
+            }
+        } else if is_video(&p) {
+            push(p, None);
+        }
+    }
+}
+
+/// While the window is open, files dropped on the app are for it (not imported).
+pub fn take_drops(ctx: &egui::Context) -> bool {
+    if !with(|s| s.open) || with(|s| s.running.load(Ordering::Relaxed)) {
+        return false;
+    }
+    let dropped = ctx.input(|i| i.raw.dropped_files.clone());
+    if dropped.is_empty() {
+        return false;
+    }
+    add(dropped.iter().map(|f| f.path().to_path_buf()).filter(|p| p.exists()).collect());
+    ctx.input_mut(|i| i.raw.dropped_files.clear());
+    true
+}
+
+fn default_out(rows: &[Row]) -> Option<PathBuf> {
+    let first = rows.first()?;
+    let base = first.root.clone().or_else(|| first.path.parent().map(Path::to_path_buf))?;
+    Some(base.join(t("Compressed")))
+}
+
+fn size_text(b: u64) -> String {
+    let mb = b as f64 / 1_048_576.0;
+    if mb >= 1024.0 { format!("{:.2} GB", mb / 1024.0) } else { format!("{mb:.1} MB") }
+}
+
+pub fn show(app: &mut crate::FilmcraftApp, ctx: &egui::Context) {
+    if !with(|s| s.open) {
+        return;
+    }
+    let (rows, running, stop) = with(|s| (s.rows.clone(), s.running.clone(), s.stop.clone()));
+    let mut open = true;
+    let mut pick: Option<crate::native_dialogs::FileDialog> = None;
+    let mut pick_out = false;
+    egui::Window::new(t("Compress Video")).open(&mut open).default_size([680.0, 460.0]).resizable(true).collapsible(false).show(ctx, |ui| {
+        let busy = running.load(Ordering::Relaxed);
+        ui.label(egui::RichText::new(t("Makes videos much smaller with no visible loss. The originals stay as they are; the results go to another folder.")).weak());
+        if ffmpeg().is_none() {
+            ui.colored_label(egui::Color32::from_rgb(0xE0, 0x6C, 0x4A), t("The video encoder (FFmpeg) was not found: it comes with CraftOffice in its tools folder."));
+            return;
+        }
+        ui.add_space(4.0);
+        ui.add_enabled_ui(!busy, |ui| {
+            ui.horizontal_wrapped(|ui| {
+                if ui.button(t("Add Folder…")).clicked() {
+                    pick = Some(crate::native_dialogs::FileDialog::Folder { at: None });
+                }
+                if ui.button(t("Add Files…")).clicked() {
+                    pick = Some(crate::native_dialogs::FileDialog::open_files(VIDEO));
+                }
+                if ui.button(t("Clear List")).clicked() {
+                    rows.lock().unwrap_or_else(std::sync::PoisonError::into_inner).clear();
+                }
+                ui.label(egui::RichText::new(t("…or drop a folder or files here")).weak().small());
+            });
+            ui.horizontal(|ui| {
+                ui.label(t("Codec:"));
+                let mut codec = with(|s| s.codec);
+                egui::ComboBox::from_id_salt("co_compress_codec").selected_text(t(codec.label())).width(340.0).show_ui(ui, |ui| {
+                    for c in [Codec::Av1, Codec::Hevc, Codec::H264] {
+                        ui.add_enabled_ui(available(c), |ui| ui.selectable_value(&mut codec, c, t(c.label())));
+                    }
+                });
+                with(|s| s.codec = codec);
+            });
+            ui.horizontal(|ui| {
+                ui.label(t("Quality:"));
+                let mut high = with(|s| s.high);
+                ui.radio_value(&mut high, true, t("No visible loss"));
+                ui.radio_value(&mut high, false, t("Smaller, hardly visible loss"));
+                with(|s| s.high = high);
+            });
+            ui.horizontal(|ui| {
+                ui.label(t("Save to:"));
+                let list = rows.lock().unwrap_or_else(std::sync::PoisonError::into_inner).clone();
+                let shown = with(|s| s.out_dir.clone()).or_else(|| default_out(&list));
+                ui.label(egui::RichText::new(shown.map_or_else(|| "—".to_string(), |p| p.display().to_string())).monospace());
+                if ui.button(t("Choose…")).clicked() {
+                    pick_out = true;
+                }
+            });
+        });
+        ui.separator();
+        let list = rows.lock().unwrap_or_else(std::sync::PoisonError::into_inner).clone();
+        ui.horizontal(|ui| {
+            if ui.add_enabled(!list.is_empty() && !busy, egui::Button::new(egui::RichText::new(t("Compress")).strong())).clicked() {
+                start(&rows, &running, &stop);
+            }
+            if busy && ui.button(t("Stop")).clicked() {
+                stop.store(true, Ordering::Relaxed);
+            }
+            let (before, after): (u64, u64) = list.iter().fold((0, 0), |(b, a), r| match r.status {
+                Status::Done { before, after } => (b + before, a + after),
+                _ => (b, a),
+            });
+            if before > 0 {
+                ui.label(format!("{} → {}  (−{:.0}%)", size_text(before), size_text(after), 100.0 - after as f64 * 100.0 / before as f64));
+            }
+        });
+        egui::ScrollArea::vertical().auto_shrink([false, false]).show(ui, |ui| {
+            egui::Grid::new("co_compress_rows").striped(true).num_columns(2).spacing([12.0, 3.0]).show(ui, |ui| {
+                for r in &list {
+                    let name = r.root.as_ref().and_then(|root| r.path.strip_prefix(root).ok()).unwrap_or(&r.path).display().to_string();
+                    ui.label(name);
+                    match &r.status {
+                        Status::Waiting => {
+                            ui.label("");
+                        }
+                        Status::Working(p) => {
+                            ui.add(egui::ProgressBar::new(*p).desired_width(200.0).show_percentage());
+                        }
+                        Status::Done { before, after } => {
+                            ui.label(format!("✓ {} → {}  (−{:.0}%)", size_text(*before), size_text(*after), 100.0 - *after as f64 * 100.0 / (*before).max(1) as f64));
+                        }
+                        Status::Kept(why) => {
+                            ui.label(format!("– {why}"));
+                        }
+                        Status::Failed(why) => {
+                            ui.label(format!("✗ {why}"));
+                        }
+                    }
+                    ui.end_row();
+                }
+            });
+        });
+    });
+    if let Some(d) = pick {
+        app.pick_ui(d, |_, paths| add(paths.into_iter().map(PathBuf::from).collect()));
+    }
+    if pick_out {
+        app.pick_ui(crate::native_dialogs::FileDialog::Folder { at: None }, |_, paths| {
+            if let Some(p) = paths.into_iter().next() {
+                with(|s| s.out_dir = Some(PathBuf::from(p)));
+            }
+        });
+    }
+    if running.load(Ordering::Relaxed) {
+        ctx.request_repaint_after(std::time::Duration::from_millis(250));
+    }
+    if !open {
+        stop.store(true, Ordering::Relaxed);
+        with(|s| s.open = false);
+    }
+}
+
+fn start(rows: &Arc<Mutex<Vec<Row>>>, running: &Arc<AtomicBool>, stop: &Arc<AtomicBool>) {
+    let Some((exe, _)) = ffmpeg().cloned() else { return };
+    let (codec, high, out) = with(|s| (s.codec, s.high, s.out_dir.clone()));
+    let list = rows.lock().unwrap_or_else(std::sync::PoisonError::into_inner).clone();
+    let Some(out) = out.or_else(|| default_out(&list)) else { return };
+    running.store(true, Ordering::Relaxed);
+    stop.store(false, Ordering::Relaxed);
+    let (rows, running, stop) = (rows.clone(), running.clone(), stop.clone());
+    std::thread::spawn(move || {
+        for (i, row) in list.iter().enumerate() {
+            if stop.load(Ordering::Relaxed) {
+                break;
+            }
+            let set = |st: Status| {
+                if let Some(r) = rows.lock().unwrap_or_else(std::sync::PoisonError::into_inner).get_mut(i) {
+                    r.status = st;
+                }
+            };
+            set(Status::Working(0.0));
+            let st = compress(&exe, row, &out, codec, high, &stop, &set).unwrap_or_else(Status::Failed);
+            set(st);
+        }
+        running.store(false, Ordering::Relaxed);
+    });
+}
+
+/// The length in seconds and the first audio codec, from FFmpeg's description of the file.
+fn probe(exe: &Path, path: &Path) -> (f64, Option<String>) {
+    let out = command(exe).arg("-hide_banner").arg("-i").arg(path).stdin(Stdio::null()).output();
+    let text = out.map(|o| String::from_utf8_lossy(&o.stderr).into_owned()).unwrap_or_default();
+    let mut secs = 0.0;
+    let mut audio = None;
+    for line in text.lines() {
+        let l = line.trim();
+        if let Some(rest) = l.strip_prefix("Duration: ") {
+            let d = rest.split(',').next().unwrap_or("");
+            let parts: Vec<f64> = d.split(':').filter_map(|p| p.trim().parse().ok()).collect();
+            if parts.len() == 3 {
+                secs = parts[0] * 3600.0 + parts[1] * 60.0 + parts[2];
+            }
+        }
+        if audio.is_none() {
+            if let Some(i) = l.find("Audio: ") {
+                audio = l[i + 7..].split([' ', ',']).next().map(str::to_string);
+            }
+        }
+    }
+    (secs, audio)
+}
+
+fn compress(exe: &Path, row: &Row, out_dir: &Path, codec: Codec, high: bool, stop: &AtomicBool, set: &dyn Fn(Status)) -> Result<Status, String> {
+    let before = std::fs::metadata(&row.path).map_err(|e| e.to_string())?.len();
+    let rel = row.root.as_ref().and_then(|r| row.path.strip_prefix(r).ok()).map(Path::to_path_buf).unwrap_or_else(|| row.path.file_name().map(PathBuf::from).unwrap_or_default());
+    let dest = out_dir.join(rel).with_extension("mp4");
+    if dest == row.path {
+        return Err(t("the output folder must differ from the source"));
+    }
+    if let Some(dir) = dest.parent() {
+        std::fs::create_dir_all(dir).map_err(|e| e.to_string())?;
+    }
+    let part = dest.with_extension("part.mp4");
+    let (secs, audio) = probe(exe, &row.path);
+    // sound kept as it is when MP4 can carry it; otherwise AAC at a transparent rate
+    let copy_audio = audio.as_deref().is_some_and(|a| matches!(a, "aac" | "mp3" | "ac3" | "eac3" | "opus" | "alac" | "flac"));
+    let mut cmd = command(exe);
+    cmd.args(["-hide_banner", "-nostdin", "-y", "-i"]).arg(&row.path);
+    cmd.args(["-map", "0:v:0", "-map", "0:a?", "-map_metadata", "0", "-map_chapters", "0"]);
+    cmd.args(codec.args(high));
+    if copy_audio {
+        cmd.args(["-c:a", "copy"]);
+    } else {
+        cmd.args(["-c:a", "aac", "-b:a", "192k"]);
+    }
+    cmd.args(["-movflags", "+faststart", "-progress", "pipe:1", "-nostats", "-loglevel", "error"]).arg(&part);
+    let mut child = cmd.stdout(Stdio::piped()).stderr(Stdio::piped()).stdin(Stdio::null()).spawn().map_err(|e| e.to_string())?;
+    let err_pipe = child.stderr.take();
+    let err_text = std::thread::spawn(move || {
+        let mut s = String::new();
+        if let Some(mut e) = err_pipe {
+            let _ = std::io::Read::read_to_string(&mut e, &mut s);
+        }
+        s
+    });
+    if let Some(stdout) = child.stdout.take() {
+        for line in BufReader::new(stdout).lines().map_while(Result::ok) {
+            if stop.load(Ordering::Relaxed) {
+                let _ = child.kill();
+                break;
+            }
+            if let Some(us) = line.strip_prefix("out_time_us=").and_then(|v| v.trim().parse::<f64>().ok()) {
+                if secs > 0.0 {
+                    set(Status::Working((us / 1e6 / secs).clamp(0.0, 1.0) as f32));
+                }
+            }
+        }
+    }
+    let status = child.wait().map_err(|e| e.to_string())?;
+    let errors = err_text.join().unwrap_or_default();
+    if stop.load(Ordering::Relaxed) {
+        let _ = std::fs::remove_file(&part);
+        return Ok(Status::Kept(t("stopped")));
+    }
+    if !status.success() {
+        let _ = std::fs::remove_file(&part);
+        let last = errors.lines().rev().find(|l| !l.trim().is_empty()).unwrap_or("FFmpeg").to_string();
+        return Err(last);
+    }
+    let after = std::fs::metadata(&part).map_err(|e| e.to_string())?.len();
+    if after >= before {
+        let _ = std::fs::remove_file(&part);
+        return Ok(Status::Kept(t("already small: it would not get smaller")));
+    }
+    std::fs::rename(&part, &dest).map_err(|e| e.to_string())?;
+    Ok(Status::Done { before, after })
+}
