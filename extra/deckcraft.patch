diff --git a/crates/ui-egui/src/backstage/direct_print.rs b/crates/ui-egui/src/backstage/direct_print.rs
new file mode 100644
index 0000000..774df41
--- /dev/null
+++ b/crates/ui-egui/src/backstage/direct_print.rs
@@ -0,0 +1,210 @@
+//! CraftOffice: direct printing from File › Print to a system printer (through the host's
+//! spooler service), as PowerPoint and LibreOffice Impress do. The PDF the Print page already
+//! builds is handed to the printer; without the services (web) the page keeps its PDF route.
+//!
+//! The state lives on the UI thread only, so it stays out of [`super::Backstage`] (which is
+//! `Clone`) and survives closing and reopening the File tab.
+
+use std::cell::RefCell;
+use std::sync::mpsc::{Receiver, TryRecvError};
+use std::time::Duration;
+
+use super::{SlideApp, Ui, Value};
+use crate::services::{PrintJob, PrinterInfo};
+
+const SIDES: [(u8, &str); 3] = [
+    (0, "Print One Sided"),
+    (1, "Print on Both Sides (flip on long edge)"),
+    (2, "Print on Both Sides (flip on short edge)"),
+];
+
+struct State {
+    printers: Vec<PrinterInfo>,
+    loading: Option<Receiver<Vec<PrinterInfo>>>,
+    asked: bool,
+    printer: Option<String>,
+    copies: u32,
+    sides: u8,
+    grayscale: bool,
+    job: Option<Receiver<Result<(), String>>>,
+}
+
+impl Default for State {
+    fn default() -> Self {
+        State { printers: Vec::new(), loading: None, asked: false, printer: None, copies: 1, sides: 0, grayscale: false, job: None }
+    }
+}
+
+thread_local! {
+    static STATE: RefCell<State> = RefCell::new(State::default());
+}
+
+/// The host can print directly (desktop).
+pub fn available(app: &SlideApp) -> bool {
+    app.services.print_submit.is_some()
+}
+
+/// Start (or restart) printer discovery.
+fn discover(app: &mut SlideApp, s: &mut State) {
+    if let Some(list) = app.services.printers.as_mut() {
+        s.loading = Some(list());
+    }
+    s.asked = true;
+}
+
+/// Copies next to the Print button, as in PowerPoint.
+pub fn copies(ui: &mut Ui) {
+    STATE.with_borrow_mut(|s| {
+        ui.horizontal(|ui| {
+            let l = ui.label("Copies:");
+            ui.add(egui::DragValue::new(&mut s.copies).range(1..=999).speed(0.2)).labelled_by(l.id);
+        });
+    });
+}
+
+/// The Printer section: printer choice, sides and colour.
+pub fn settings(app: &mut SlideApp, ui: &mut Ui) {
+    STATE.with_borrow_mut(|s| {
+        if !s.asked {
+            discover(app, s);
+        }
+        if let Some(rx) = &s.loading {
+            match rx.try_recv() {
+                Ok(list) => {
+                    if s.printer.as_ref().is_none_or(|p| !list.iter().any(|x| &x.name == p)) {
+                        s.printer = list.iter().find(|p| p.default).or(list.first()).map(|p| p.name.clone());
+                    }
+                    s.printers = list;
+                    s.loading = None;
+                }
+                Err(TryRecvError::Empty) => ui.ctx().request_repaint_after(Duration::from_millis(200)),
+                Err(TryRecvError::Disconnected) => s.loading = None,
+            }
+        }
+        let label = |p: &PrinterInfo| if p.label.is_empty() { p.name.clone() } else { p.label.clone() };
+        let selected = match (&s.printer, s.loading.is_some()) {
+            (_, true) if s.printers.is_empty() => "Looking for printers…".to_string(),
+            (Some(name), _) => s.printers.iter().find(|p| &p.name == name).map_or_else(|| name.clone(), label),
+            (None, _) => "No printer found".to_string(),
+        };
+        ui.horizontal(|ui| {
+            craft_ui::ComboBox::from_id_salt("craftoffice_print_printer")
+                .width(206.0)
+                .selected_text(selected)
+                .show_ui(ui, |ui| {
+                    for p in &s.printers {
+                        let text = if p.default { format!("{} (default)", label(p)) } else { label(p) };
+                        if ui.selectable_label(s.printer.as_ref() == Some(&p.name), text).clicked() {
+                            s.printer = Some(p.name.clone());
+                        }
+                    }
+                })
+                .response
+                .widget_info(|| egui::WidgetInfo::labeled(egui::Role::ComboBox, true, "Printer"));
+            if ui.small_button("⟳").on_hover_text("Refresh the printer list").clicked() {
+                discover(app, s);
+            }
+        });
+        ui.add_space(4.0);
+        let sides = SIDES.iter().find(|x| x.0 == s.sides).map_or(SIDES[0].1, |x| x.1);
+        craft_ui::ComboBox::from_id_salt("craftoffice_print_sides")
+            .width(240.0)
+            .selected_text(sides)
+            .show_ui(ui, |ui| {
+                for (id, text) in SIDES {
+                    if ui.selectable_label(s.sides == id, text).clicked() {
+                        s.sides = id;
+                    }
+                }
+            })
+            .response
+            .widget_info(|| egui::WidgetInfo::labeled(egui::Role::ComboBox, true, "Sides"));
+        ui.add_space(4.0);
+        let colour = if s.grayscale { "Grayscale" } else { "Color" };
+        craft_ui::ComboBox::from_id_salt("craftoffice_print_colour")
+            .width(240.0)
+            .selected_text(colour)
+            .show_ui(ui, |ui| {
+                for (grey, text) in [(false, "Color"), (true, "Grayscale")] {
+                    if ui.selectable_label(s.grayscale == grey, text).clicked() {
+                        s.grayscale = grey;
+                    }
+                }
+            })
+            .response
+            .widget_info(|| egui::WidgetInfo::labeled(egui::Role::ComboBox, true, "Color"));
+    });
+}
+
+/// Build the PDF for `params` and hand it to the chosen printer. `true` when a job left.
+pub fn print(app: &mut SlideApp, params: Value) -> bool {
+    let Some((title, doc)) = app.session.active().map(|d| (d.title(), d.doc.clone())) else { return false };
+    let job = STATE.with_borrow(|s| {
+        s.printer.clone().map(|printer| PrintJob { printer, copies: s.copies.clamp(1, 999), duplex: s.sides, grayscale: s.grayscale, title })
+    });
+    let Some(job) = job else {
+        app.set_status("Choose a printer first.");
+        return false;
+    };
+    let bytes = match deckcraft_engine::cmd::file::pdf_bytes(&doc, &params) {
+        Ok(bytes) => bytes,
+        Err(e) => {
+            app.set_status(format!("Couldn't prepare the pages to print: {e}"));
+            return false;
+        }
+    };
+    let Some(submit) = app.services.print_submit.as_mut() else { return false };
+    let rx = submit(bytes, job);
+    STATE.with_borrow_mut(|s| s.job = Some(rx));
+    app.set_status("Sending the presentation to the printer…");
+    true
+}
+
+/// Report how the last job went. Call every frame while the File tab shows.
+pub fn poll(app: &mut SlideApp, ui: &Ui) {
+    let done = STATE.with_borrow_mut(|s| {
+        let rx = s.job.as_ref()?;
+        match rx.try_recv() {
+            Ok(result) => {
+                s.job = None;
+                Some(result)
+            }
+            Err(TryRecvError::Empty) => {
+                ui.ctx().request_repaint_after(Duration::from_millis(250));
+                None
+            }
+            Err(TryRecvError::Disconnected) => {
+                s.job = None;
+                Some(Err("the print job stopped unexpectedly".into()))
+            }
+        }
+    });
+    match done {
+        Some(Ok(())) => app.set_status("Sent to the printer."),
+        Some(Err(e)) => app.set_status(format!("Couldn't print: {e}")),
+        None => {}
+    }
+}
+
+/// A job is still on its way to the spooler.
+pub fn busy() -> bool {
+    STATE.with_borrow(|s| s.job.is_some())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn sides_cover_the_three_spooler_modes() {
+        let ids: Vec<u8> = SIDES.iter().map(|s| s.0).collect();
+        assert_eq!(ids, vec![0, 1, 2]);
+    }
+
+    #[test]
+    fn default_state_prints_one_colour_copy_one_sided() {
+        let s = State::default();
+        assert_eq!((s.copies, s.sides, s.grayscale), (1, 0, false));
+        assert!(s.printer.is_none() && s.job.is_none());
+    }
+}
