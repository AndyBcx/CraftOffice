+/// CraftOffice: a printer the system spooler offers for direct printing.
+#[derive(Clone, Debug, PartialEq)]
+pub struct PrinterInfo {
+    pub name: String,
+    pub label: String,
+    pub default: bool,
+}
+
+/// CraftOffice: one direct print job. `duplex`: 0 one-sided, 1 long edge, 2 short edge.
+#[derive(Clone, Debug, PartialEq)]
+pub struct PrintJob {
+    pub printer: String,
+    pub copies: u32,
+    pub duplex: u8,
+    pub grayscale: bool,
+    pub title: String,
+}
+
+/// Lists the printers on a background thread; the list arrives through the receiver.
+pub type PrintersFn = Box<dyn FnMut() -> std::sync::mpsc::Receiver<Vec<PrinterInfo>>>;
+
+/// Hands PDF bytes to the spooler on a background thread; the outcome arrives through the receiver.
+pub type PrintSubmitFn = Box<dyn FnMut(Vec<u8>, PrintJob) -> std::sync::mpsc::Receiver<Result<(), String>>>;
+
 /// Platform services injected by the host (desktop or web).
 #[derive(Default)]
 pub struct Services {
+    /// CraftOffice: printer discovery for File › Print; absent on the web.
+    pub printers: Option<PrintersFn>,
+    /// CraftOffice: direct submission to a printer; absent on the web (Print then goes through a PDF).
+    pub print_submit: Option<PrintSubmitFn>,
     /// Browser-owned presenter popup; absent on native hosts.
     pub presenter: Option<Box<dyn crate::presenter::Host>>,
     /// Open-file dialog for a purpose (`open`, `picture`, `audio`, `video`) → path.
