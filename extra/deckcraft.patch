diff --git a/apps/deckcraft/src/printing.rs b/apps/deckcraft/src/printing.rs
new file mode 100644
index 0000000..43c3cae
--- /dev/null
+++ b/apps/deckcraft/src/printing.rs
@@ -0,0 +1,77 @@
+//! CraftOffice: the desktop spooler for File › Print (craft-print). Discovery and submission
+//! never run on the UI thread.
+use deckcraft_ui_egui::{PrintJob, PrinterInfo};
+use std::sync::mpsc::{Receiver, channel};
+
+/// Lists the system printers on a background thread.
+pub fn discover() -> Receiver<Vec<PrinterInfo>> {
+    let (sender, receiver) = channel();
+    let _ = std::thread::Builder::new().name("print-discovery".into()).spawn(move || {
+        let printers = craft_print::printers()
+            .into_iter()
+            .map(|p| PrinterInfo { name: p.name, label: p.description, default: p.default })
+            .collect();
+        let _ = sender.send(printers);
+    });
+    receiver
+}
+
+// Workers stay reachable until shutdown: dropping a JoinHandle would let the process exit kill
+// PowerShell/CUPS before it hands the job to the spooler.
+static JOBS: std::sync::Mutex<Vec<std::thread::JoinHandle<()>>> = std::sync::Mutex::new(Vec::new());
+
+pub fn finish_pending_jobs() {
+    let workers = std::mem::take(&mut *JOBS.lock().unwrap_or_else(std::sync::PoisonError::into_inner));
+    for worker in workers {
+        let _ = worker.join();
+    }
+}
+
+/// The craft-print job for a [`PrintJob`].
+fn job(j: &PrintJob) -> craft_print::Job {
+    craft_print::Job {
+        printer: Some(j.printer.clone()),
+        copies: j.copies.clamp(1, 999),
+        duplex: Some(match j.duplex {
+            1 => craft_print::Duplex::LongEdge,
+            2 => craft_print::Duplex::ShortEdge,
+            _ => craft_print::Duplex::Off,
+        }),
+        grayscale: j.grayscale,
+        scaling: craft_print::Scaling::ShrinkToFit,
+        title: if j.title.is_empty() { "CraftOffice Slides".into() } else { j.title.clone() },
+        ..Default::default()
+    }
+}
+
+/// Hands the PDF to the spooler on a background thread.
+pub fn submit(pdf: Vec<u8>, j: PrintJob) -> Receiver<Result<(), String>> {
+    let (sender, receiver) = channel();
+    let job = job(&j);
+    let worker = std::thread::Builder::new().name("print-submit".into()).spawn(move || {
+        let _ = sender.send(craft_print::submit(&pdf, &job).map(|_| ()).map_err(|e| e.to_string()));
+    });
+    if let Ok(worker) = worker {
+        let mut jobs = JOBS.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+        jobs.retain(|w| !w.is_finished());
+        jobs.push(worker);
+    }
+    receiver
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn job_maps_sides_copies_and_colour() {
+        let j = job(&PrintJob { printer: "P".into(), copies: 0, duplex: 1, grayscale: true, title: String::new() });
+        assert_eq!(j.printer.as_deref(), Some("P"));
+        assert_eq!(j.copies, 1);
+        assert_eq!(j.duplex, Some(craft_print::Duplex::LongEdge));
+        assert!(j.grayscale);
+        assert_eq!(j.title, "CraftOffice Slides");
+        let j = job(&PrintJob { printer: "P".into(), copies: 5000, duplex: 2, grayscale: false, title: "Deck".into() });
+        assert_eq!((j.copies, j.duplex, j.title.as_str()), (999, Some(craft_print::Duplex::ShortEdge), "Deck"));
+    }
+}
